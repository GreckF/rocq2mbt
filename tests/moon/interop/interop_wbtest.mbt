// Runtime tests for tests/Interop.v: Rocq code calling tests/moon/mlib
// through the axioms generated by mbti2rocq.

fn ints(l : List[Int]) -> Array[Int] {
  let out = []
  fn go(l : List[Int]) {
    match l {
      List::Nil => ()
      List::Cons(x, t) => {
        out.push(x)
        go(t)
      }
    }
  }
  go(l)
  out
}

test "enums with labelled constructors" {
  assert_eq(total_area(shapes), 9.0)
  assert_eq(kind(@mlib.Shape::Rect(w=1.0, h=2.0)), 1)
  assert_eq(kind(@mlib.Shape::Dot), 2)
  assert_eq(rect_width(@mlib.Shape::Rect(w=4.0, h=2.0)), Some(4.0))
  assert_eq(rect_width(@mlib.Shape::Circle(1.0)), None)
}

test "records, methods, constants, abstract types" {
  assert_eq(far.x, -6)
  assert_eq(far.y, 3)
  assert_eq(far_norm, 9)
  assert_eq(origin_norm, 0)
  assert_eq(counter_value, 100)
}

test "trait-bounded functions and callbacks" {
  assert_eq(ints(sorted), [1, 3, 5])
  assert_eq(tree_sum, 9)
  assert_eq(added, 13)
}

test "raise functions" {
  assert_eq(digit_or_minus1("7"), 7)
  assert_eq(digit_or_minus1("x"), -1)
  assert_eq(digit_or_minus1(""), -2)
}

test "traits as classes" {
  assert_eq(pretty_test, "#7 (-6, 3)")
  assert_eq(pretty_array, "#1 #1 #2")
  assert_eq(labelled, "answer: 42")
}
